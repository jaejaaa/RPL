<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- koneksi database (DataSource) diatur oleh Spring di config/AppConfig.java -->

        <!-- dialek SQL sesuai database di XAMPP (MariaDB 10.4) -->
        <property name="hibernate.boot.allow_jdbc_metadata_access">false</property>
        <property name="jakarta.persistence.database-product-name">MariaDB</property>
        <property name="jakarta.persistence.database-major-version">10</property>
        <property name="jakarta.persistence.database-minor-version">4</property>

        <!-- tampilkan SQL yang dibuat Hibernate di Output -->
        <property name="hibernate.show_sql">true</property>

        <!-- struktur tabel tetap mengikuti database/simerp.sql, tidak diubah otomatis -->
        <property name="hibernate.hbm2ddl.auto">none</property>

        <!-- class yang dipetakan ke tabel -->
        <mapping class="com.satupadu.satupaduerp.model.Role"/>
        <mapping class="com.satupadu.satupaduerp.model.User"/>
        <mapping class="com.satupadu.satupaduerp.model.Product"/>
        <mapping class="com.satupadu.satupaduerp.model.Customer"/>
        <mapping class="com.satupadu.satupaduerp.model.Supplier"/>
        <mapping class="com.satupadu.satupaduerp.model.SalesOrder"/>
        <mapping class="com.satupadu.satupaduerp.model.SalesOrderItem"/>
        <mapping class="com.satupadu.satupaduerp.model.StockMovement"/>
        <mapping class="com.satupadu.satupaduerp.model.CashTransaction"/>
    </session-factory>
</hibernate-configuration>
